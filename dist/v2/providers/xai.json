{
  "$schema": "https://raw.githubusercontent.com/ailib-official/ai-protocol/main/schemas/v2/provider.json",
  "id": "xai",
  "protocol_version": "2.0",
  "name": "xAI",
  "version": "1.0.0",
  "status": "stable",
  "category": "ai_provider",
  "official_url": "https://docs.x.ai",
  "support_contact": "https://x.ai/api",
  "endpoint": {
    "base_url": "https://api.x.ai/v1",
    "chat": "/chat/completions",
    "auth": {
      "type": "bearer",
      "header": "Authorization",
      "prefix": "Bearer",
      "token_env": "XAI_API_KEY"
    }
  },
  "error_classification": {
    "by_http_status": {
      "400": "invalid_request",
      "401": "authentication",
      "403": "permission_denied",
      "404": "not_found",
      "429": "rate_limited",
      "500": "server_error",
      "503": "overloaded"
    },
    "by_error_code": {
      "context_length_exceeded": "request_too_large",
      "model_not_found": "not_found",
      "rate_limit_exceeded": "rate_limited"
    }
  },
  "availability": {
    "required": false,
    "regions": [
      "global"
    ],
    "check": {
      "method": "GET",
      "path": "/models",
      "expected_status": [
        200,
        401
      ],
      "timeout_ms": 3000
    }
  },
  "capabilities": {
    "required": [
      "text",
      "streaming",
      "tools"
    ],
    "optional": [
      "vision",
      "parallel_tools",
      "agentic",
      "reasoning",
      "structured_output"
    ],
    "feature_flags": {
      "parallel_tool_calls": true,
      "extended_thinking": true,
      "streaming_usage": true,
      "system_messages": true,
      "structured_output": true
    },
    "tool_calling": {
      "native": {
        "supported": true,
        "reliability": "full",
        "parallel": true,
        "streaming": true,
        "notes": "OpenAI-compatible tool_calls; arguments are JSON strings"
      },
      "text_fallback": null
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "range": [
        0,
        2
      ],
      "default": 1
    },
    "max_tokens": {
      "type": "integer",
      "min": 1,
      "max": 131072
    },
    "top_p": {
      "type": "float",
      "range": [
        0,
        1
      ]
    },
    "stream": {
      "type": "boolean"
    },
    "frequency_penalty": {
      "type": "float",
      "range": [
        -2,
        2
      ]
    },
    "presence_penalty": {
      "type": "float",
      "range": [
        -2,
        2
      ]
    }
  },
  "streaming": {
    "decoder": {
      "format": "sse",
      "strategy": "openai_chat",
      "done_signal": "[DONE]",
      "prefix": "data: "
    },
    "content_path": "$.choices[0].delta.content",
    "tool_call_path": "$.choices[0].delta.tool_calls",
    "usage_path": "$.usage",
    "event_map": [
      {
        "match": "exists($.choices[*].delta.content)",
        "emit": "PartialContentDelta",
        "fields": {
          "content": "$.choices[*].delta.content"
        }
      },
      {
        "match": "exists($.choices[*].delta.tool_calls)",
        "emit": "PartialToolCall",
        "fields": {
          "tool_calls": "$.choices[*].delta.tool_calls"
        }
      },
      {
        "match": "exists($.usage)",
        "emit": "Metadata",
        "fields": {
          "usage": "$.usage"
        }
      },
      {
        "match": "$.choices[*].finish_reason != null",
        "emit": "StreamEnd",
        "fields": {
          "finish_reason": "$.choices[*].finish_reason"
        }
      }
    ],
    "stop_condition": "$.choices[0].finish_reason != null"
  },
  "multimodal": {
    "input": {
      "vision": {
        "supported": true,
        "formats": [
          "jpeg",
          "png",
          "gif",
          "webp"
        ],
        "encoding_methods": [
          "base64_inline",
          "url"
        ]
      },
      "audio": {
        "supported": false
      },
      "video": {
        "supported": false
      }
    },
    "output": {
      "text": true,
      "audio": {
        "supported": false
      },
      "image": {
        "supported": false
      }
    }
  },
  "api_families": [
    "chat_completions"
  ],
  "default_api_family": "chat_completions",
  "endpoints": {
    "chat": {
      "path": "/chat/completions",
      "method": "POST",
      "adapter": "openai"
    }
  },
  "services": {
    "list_models": {
      "path": "/models",
      "method": "GET",
      "response_binding": "data"
    }
  },
  "retry_policy": {
    "strategy": "exponential_backoff",
    "max_retries": 3,
    "min_delay_ms": 1000,
    "max_delay_ms": 30000,
    "jitter": "full",
    "retry_on_http_status": [
      429,
      500,
      502,
      503
    ]
  },
  "termination": {
    "source_field": "finish_reason",
    "mapping": {
      "stop": "end_turn",
      "length": "max_tokens",
      "tool_calls": "tool_use",
      "content_filter": "refusal"
    }
  },
  "metadata": {
    "api_compatibility": "openai",
    "models": {
      "grok-4.5": {
        "context_window": 500000,
        "max_output_tokens": 131072,
        "status": "active",
        "family": "grok-4",
        "knowledge_cutoff": "2026-02",
        "thinking": "dual_mode",
        "model_capabilities": {
          "tool_call": true,
          "structured_output": true,
          "reasoning": true,
          "attachment": true
        },
        "modalities": {
          "input": [
            "text",
            "image"
          ],
          "output": [
            "text"
          ]
        },
        "verification": {
          "status": "verified",
          "source": "official_documentation",
          "verified_at": "2026-07-24"
        }
      },
      "grok-4.3": {
        "context_window": 1000000,
        "max_output_tokens": 131072,
        "status": "active",
        "family": "grok-4",
        "model_capabilities": {
          "tool_call": true,
          "structured_output": true,
          "reasoning": true,
          "attachment": true
        },
        "modalities": {
          "input": [
            "text",
            "image"
          ],
          "output": [
            "text"
          ]
        },
        "verification": {
          "status": "verified",
          "source": "official_documentation",
          "verified_at": "2026-07-24"
        }
      },
      "grok-3-mini": {
        "context_window": 131072,
        "max_output_tokens": 8192,
        "status": "active",
        "family": "grok-3",
        "model_capabilities": {
          "tool_call": true,
          "reasoning": true,
          "attachment": true
        },
        "modalities": {
          "input": [
            "text",
            "image"
          ],
          "output": [
            "text"
          ]
        },
        "verification": {
          "status": "verified",
          "source": "official_documentation",
          "verified_at": "2026-07-24"
        }
      },
      "grok-4.20-0309-reasoning": {
        "context_window": 1000000,
        "max_output_tokens": 30000,
        "status": "active",
        "family": "grok-4",
        "open_weights": false,
        "model_capabilities": {
          "tool_call": true,
