{
  "$schema": "https://raw.githubusercontent.com/ailib-official/ai-protocol/main/schemas/v2/provider.json",
  "id": "cerebras",
  "protocol_version": "2.0",
  "name": "Cerebras",
  "version": "1.0.0",
  "status": "stable",
  "category": "ai_provider",
  "official_url": "https://inference-docs.cerebras.ai",
  "support_contact": "https://cerebras.ai/contact",
  "endpoint": {
    "base_url": "https://api.cerebras.ai/v1",
    "chat": "/chat/completions",
    "auth": {
      "type": "bearer",
      "header": "Authorization",
      "prefix": "Bearer",
      "token_env": "CEREBRAS_API_KEY"
    }
  },
  "error_classification": {
    "by_http_status": {
      "400": "invalid_request",
      "401": "authentication",
      "403": "permission_denied",
      "404": "not_found",
      "429": "rate_limited",
      "500": "server_error",
      "503": "overloaded"
    },
    "by_error_code": {
      "context_length_exceeded": "request_too_large",
      "model_not_found": "not_found",
      "rate_limit_exceeded": "rate_limited"
    }
  },
  "availability": {
    "required": false,
    "regions": [
      "global"
    ],
    "check": {
      "method": "GET",
      "path": "/models",
      "expected_status": [
        200,
        401
      ],
      "timeout_ms": 3000
    }
  },
  "capabilities": {
    "required": [
      "text",
      "streaming",
      "tools"
    ],
    "optional": [
      "parallel_tools",
      "agentic",
      "reasoning",
      "structured_output"
    ],
    "feature_flags": {
      "parallel_tool_calls": true,
      "streaming_usage": true,
      "system_messages": true,
      "structured_output": true
    },
    "tool_calling": {
      "native": {
        "supported": true,
        "reliability": "full",
        "parallel": true,
        "streaming": true,
        "notes": "OpenAI-compatible tool_calls; backend-model dependent"
      },
      "text_fallback": null
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "range": [
        0,
        2
      ],
      "default": 1
    },
    "max_tokens": {
      "type": "integer",
      "min": 1,
      "max": 131072
    },
    "top_p": {
      "type": "float",
      "range": [
        0,
        1
      ]
    },
    "stream": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer"
    }
  },
  "streaming": {
    "decoder": {
      "format": "sse",
      "strategy": "openai_chat",
      "done_signal": "[DONE]",
      "prefix": "data: "
    },
    "content_path": "$.choices[0].delta.content",
    "tool_call_path": "$.choices[0].delta.tool_calls",
    "usage_path": "$.usage",
    "event_map": [
      {
        "match": "exists($.choices[*].delta.content)",
        "emit": "PartialContentDelta",
        "fields": {
          "content": "$.choices[*].delta.content"
        }
      },
      {
        "match": "exists($.choices[*].delta.tool_calls)",
        "emit": "PartialToolCall",
        "fields": {
          "tool_calls": "$.choices[*].delta.tool_calls"
        }
      },
      {
        "match": "exists($.usage)",
        "emit": "Metadata",
        "fields": {
          "usage": "$.usage"
        }
      },
      {
        "match": "$.choices[*].finish_reason != null",
        "emit": "StreamEnd",
        "fields": {
          "finish_reason": "$.choices[*].finish_reason"
        }
      }
    ],
    "stop_condition": "$.choices[0].finish_reason != null"
  },
  "multimodal": {
    "input": {
      "vision": {
        "supported": false
      },
      "audio": {
        "supported": false
      },
      "video": {
        "supported": false
      }
    },
    "output": {
      "text": true,
      "audio": {
        "supported": false
      },
      "image": {
        "supported": false
      }
    }
  },
  "api_families": [
    "chat_completions"
  ],
  "default_api_family": "chat_completions",
  "endpoints": {
    "chat": {
      "path": "/chat/completions",
      "method": "POST",
      "adapter": "openai"
    }
  },
  "services": {
    "list_models": {
      "path": "/models",
      "method": "GET",
      "response_binding": "data"
    }
  },
  "retry_policy": {
    "strategy": "exponential_backoff",
    "max_retries": 3,
    "min_delay_ms": 500,
    "max_delay_ms": 10000,
    "jitter": "full",
    "retry_on_http_status": [
      429,
      500,
      502,
      503
    ]
  },
  "termination": {
    "source_field": "finish_reason",
    "mapping": {
      "stop": "end_turn",
      "length": "max_tokens",
      "tool_calls": "tool_use",
      "content_filter": "refusal"
    }
  },
  "metadata": {
    "api_compatibility": "openai",
    "models": {
      "gpt-oss-120b": {
        "context_window": 131072,
        "max_output_tokens": 65536,
        "status": "active",
        "family": "gpt-oss",
        "model_capabilities": {
          "tool_call": true,
          "structured_output": true,
          "reasoning": true,
          "attachment": false
        },
        "modalities": {
          "input": [
            "text"
          ],
          "output": [
            "text"
          ]
        },
        "verification": {
          "status": "verified",
          "source": "official_documentation",
          "verified_at": "2026-07-25"
        }
      },
      "gemma-4-31b": {
        "context_window": 131072,
        "max_output_tokens": 32768,
        "status": "public_preview",
        "family": "gemma-4",
        "model_capabilities": {
          "tool_call": true,
          "structured_output": true,
          "reasoning": false,
          "attachment": false
        },
        "modalities": {
          "input": [
            "text"
          ],
          "output": [
            "text"
          ]
        },
        "verification": {
          "status": "verified",
          "source": "official_documentation",
          "verified_at": "2026-07-25",
          "notes": "Cerebras Preview catalog; may rotate — re-verify before production pin"
        }
      },
      "llama-3.3-70b": {
        "context_window": 131072,
        "max_output_tokens": 8192,
        "status": "active",
        "family": "llama-3.3",
        "model_capabilities": {
          "tool_call": true,
          "structured_output": true,
          "reasoning": false,
          "attachment": false
        },
        "modalities": {
          "input": [
            "text"
          ],
          "output": [
            "text"
          ]
        },
        "verification": {
          "status": "verified",
          "source": "official_documentation",
          "verified_at": "2026-07-25",
          "notes": "Widely used; check Cerebras deprecation calendar for migration to gpt-oss-120b"
        }
      },
      "zai-glm-4.7": {
        "context_window": 131072,
        "max_output_tokens": 40960,
        "status": "public_preview",
        "family": "glm",
        "open_weights": true,
        "model_capabilities": {
          "tool_call": true,
          "structured_output": true,
          "reasoning": true,
          "attachment": false
        },
        "modalities": {
          "input": [
            "text"
          ],
          "output": [
            "text"
          ]
        },
        "pricing": {
          "input_per_1m": 2.25,
          "output_per_1m": 2.75
        },
        "verification": {
          "status": "unverified",
          "source": "provider_catalog",
          "verified_at": "2026-07-25",
          "notes": "PT-ME-005 curated thicken from oneshot gap; confirm on vendor docs before treating as strong SoT; Cerebras Preview catalog; may rotate"
        }
      }
    },
    "sdk": {
      "note": "OpenAI-compatible — use openai SDK with base_url https://api.cerebras.ai/v1",
      "python": "openai",
      "typescript": "openai"
    }
  }
}