{
  "$schema": "https://raw.githubusercontent.com/ailib-official/ai-protocol/main/schemas/v2/provider.json",
  "id": "qwen",
  "protocol_version": "2.0",
  "name": "Qwen (DashScope)",
  "version": "3.7.0",
  "status": "stable",
  "category": "ai_provider",
  "official_url": "https://help.aliyun.com/zh/model-studio",
  "support_contact": "https://help.aliyun.com",
  "endpoint": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "chat": "/chat/completions",
    "auth": {
      "type": "bearer",
      "header": "Authorization",
      "prefix": "Bearer",
      "token_env": "QWEN_API_KEY"
    }
  },
  "error_classification": {
    "by_http_status": {
      "400": "invalid_request",
      "401": "authentication",
      "403": "permission_denied",
      "404": "not_found",
      "429": "rate_limited",
      "500": "server_error",
      "503": "overloaded"
    }
  },
  "availability": {
    "required": false,
    "regions": [
      "cn",
      "global"
    ],
    "check": {
      "method": "GET",
      "path": "/models",
      "expected_status": [
        200,
        401
      ],
      "timeout_ms": 3000
    }
  },
  "capabilities": {
    "required": [
      "text",
      "streaming",
      "tools"
    ],
    "optional": [
      "vision",
      "audio",
      "video",
      "parallel_tools",
      "reasoning",
      "structured_output",
      "image_generation",
      "stt",
      "tts"
    ],
    "feature_flags": {
      "structured_output": true,
      "parallel_tool_calls": true,
      "streaming_usage": true,
      "system_messages": true,
      "image_generation": true
    },
    "tool_calling": {
      "native": {
        "supported": true,
        "reliability": "full",
        "parallel": true,
        "streaming": true,
        "notes": "PT-079 audit: native-only unless live shows text markup fallback"
      },
      "text_fallback": null
    }
  },
  "capability_profile": {
    "phase": "ios_v1",
    "inputs": {
      "modalities": [
        "text",
        "image",
        "audio"
      ]
    },
    "outcomes": {
      "types": [
        "text_completion",
        "structured_json",
        "tool_call_sequence"
      ]
    },
    "systems": {
      "requires": [
        "mcp",
        "search"
      ]
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "range": [
        0,
        2
      ],
      "default": 1
    },
    "max_tokens": {
      "type": "integer",
      "min": 1,
      "max": 32000
    },
    "top_p": {
      "type": "float",
      "range": [
        0,
        1
      ]
    },
    "stream": {
      "type": "boolean"
    }
  },
  "streaming": {
    "decoder": {
      "format": "sse",
      "strategy": "openai_chat",
      "done_signal": "[DONE]",
      "prefix": "data: "
    },
    "content_path": "$.choices[0].delta.content",
    "tool_call_path": "$.choices[0].delta.tool_calls",
    "usage_path": "$.usage",
    "event_map": [
      {
        "match": "exists($.choices[*].delta.content)",
        "emit": "PartialContentDelta",
        "fields": {
          "content": "$.choices[*].delta.content"
        }
      },
      {
        "match": "exists($.choices[*].delta.tool_calls)",
        "emit": "PartialToolCall",
        "fields": {
          "tool_calls": "$.choices[*].delta.tool_calls"
        }
      },
      {
        "match": "exists($.usage)",
        "emit": "Metadata",
        "fields": {
          "usage": "$.usage"
        }
      },
      {
        "match": "$.choices[*].finish_reason != null",
        "emit": "StreamEnd",
        "fields": {
          "finish_reason": "$.choices[*].finish_reason"
        }
      }
    ],
    "stop_condition": "$.choices[0].finish_reason != null"
  },
  "multimodal": {
    "input": {
      "vision": {
        "supported": true,
        "formats": [
          "jpeg",
          "png",
          "gif",
          "webp"
        ],
        "encoding_methods": [
          "base64_inline",
          "url"
        ],
        "document_understanding": true
      },
      "audio": {
        "supported": true,
        "formats": [
          "mp3",
          "wav",
          "flac",
          "ogg",
          "aac"
        ],
        "speech_recognition": true,
        "real_time_streaming": true
      },
      "video": {
        "supported": true,
        "formats": [
          "mp4",
          "mov",
          "avi",
          "webm"
        ],
        "frame_extraction": "automatic",
        "audio_track": true,
        "temporal_reasoning": true
      }
    },
    "output": {
      "text": true,
      "audio": {
        "supported": true,
        "formats": [
          "wav",
          "mp3",
          "opus"
        ],
        "real_time_tts": true,
        "natural_voice": true,
        "voice_selection": true
      },
      "image": {
        "supported": true,
        "formats": [
          "png",
          "jpeg",
          "webp"
        ]
      },
      "video": {
        "supported": false
      }
    }
  },
  "api_families": [
    "chat_completions",
    "completions"
  ],
  "default_api_family": "chat_completions",
  "endpoints": {
    "chat": {
      "path": "/chat/completions",
      "method": "POST",
      "adapter": "openai"
    },
    "image_generation": {
      "path": "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation",
      "method": "POST",
      "adapter": "dashscope",
      "request_encoding": "json",
      "response_encoding": "json",
      "notes": "PT-GEN-003 Stage D sample. Native DashScope multimodal-generation (NOT OpenAI /images/generations; NOT under compatible-mode base_url). Request body uses model+input.messages (text prompt), not OpenAI prompt/size shape. Intl host: dashscope-intl.aliyuncs.com with same path. Official docs: Model Studio Qwen-Image / Wan image APIs."
    }
  },
  "services": {
    "list_models": {
      "path": "/models",
      "method": "GET",
      "response_binding": "data"
    }
  },
  "retry_policy": {
    "strategy": "exponential_backoff",
    "max_retries": 2,
    "min_delay_ms": 1000,
    "max_delay_ms": 8000,
    "jitter": "full",
    "retry_on_http_status": [
      408,
      409,
      429,
      500,
      503
    ]
  },
  "termination": {
    "source_field": "finish_reason",
    "mapping": {
      "stop": "end_turn",
      "length": "max_tokens",
      "tool_calls": "tool_use",
      "content_filter": "refusal"
    }
  },
  "metadata": {
    "api_compatibility": "openai",
    "regional": {
      "primary": "china"
    },
    "sdk": {
      "python": "openai",
      "typescript": "openai"
    },
