{
  "$schema": "https://raw.githubusercontent.com/hiddenpath/ai-protocol/main/schemas/v1.json",
  "id": "azure",
  "protocol_version": "1.1",
  "endpoint": {
    "base_url": "https://${AZURE_RESOURCE_NAME}.openai.azure.com/openai/deployments/${AZURE_DEPLOYMENT_ID}",
    "protocol": "https",
    "timeout_ms": 30000
  },
  "availability": {
    "required": true,
    "regions": [
      "global"
    ],
    "check": {
      "method": "GET",
      "path": "/models?api-version=2024-02-01",
      "expected_status": [
        200
      ]
    }
  },
  "capabilities": {
    "streaming": true,
    "tools": true,
    "vision": true
  },
  "auth": {
    "type": "api_key",
    "key_env": "AZURE_OPENAI_KEY",
    "header_name": "api-key"
  },
  "parameter_mappings": {
    "model": "model",
    "messages": "messages",
    "max_tokens": "max_tokens",
    "temperature": "temperature",
    "stream": "stream",
    "tools": "tools",
    "tool_choice": "tool_choice"
  },
  "streaming": {
    "decoder": {
      "format": "sse"
    },
    "content_path": "$.choices[0].delta.content",
    "tool_call_path": "$.choices[0].delta.tool_calls",
    "usage_path": "$.usage",
    "stop_condition": "$.choices[0].finish_reason"
  },
  "retry_policy": {
    "strategy": "exponential_backoff",
    "retry_on_http_status": [
      429,
      500,
      502,
      503
    ]
  },
  "rate_limit_headers": {
    "requests_limit": "x-ratelimit-limit-requests",
    "requests_remaining": "x-ratelimit-remaining-requests",
    "requests_reset": "x-ratelimit-reset-requests"
  }
}