{
  "$schema": "../../schemas/v1.json",
  "protocol_version": "1.5",
  "id": "anyscale",
  "name": "Anyscale",
  "status": "stable",
  "category": "model_provider",
  "official_url": "https://www.anyscale.com/",
  "support_contact": "https://www.anyscale.com/contact",
  "endpoint": {
    "base_url": "https://api.anyscale.com/v1",
    "protocol": "https",
    "timeout_ms": 60000
  },
  "auth": {
    "type": "bearer",
    "token_env": "ANYSCALE_API_TOKEN",
    "payload_format": "openai_style"
  },
  "services": {
    "list_models": {
      "path": "/models",
      "method": "GET",
      "response_binding": "data"
    }
  },
  "availability": {
    "required": false,
    "regions": [
      "global"
    ],
    "check": {
      "method": "GET",
      "path": "/models",
      "expected_status": [
        200
      ]
    }
  },
  "capabilities": {
    "streaming": true,
    "tools": true,
    "vision": false,
    "agentic": false,
    "reasoning": false,
    "parallel_tools": false
  },
  "streaming": {
    "event_format": "data_lines",
    "decoder": {
      "format": "sse",
      "delimiter": "\n\n",
      "prefix": "data: ",
      "done_signal": "[DONE]"
    }
  },
  "response_format": "openai_style",
  "response_paths": {
    "content": "choices.0.message.content",
    "finish_reason": "choices.0.finish_reason",
    "model": "model",
    "id": "id",
    "created": "created"
  },
  "error_classification": {
    "by_http_status": {
      "400": "invalid_request",
      "401": "authentication",
      "403": "permission_denied",
      "404": "not_found",
      "409": "conflict",
      "429": "rate_limited",
      "500": "server_error",
      "502": "server_error",
      "503": "server_error",
      "504": "timeout"
    }
  },
  "retry_policy": {
    "max_retries": 3,
    "max_delay_ms": 30000,
    "strategy": "exponential_backoff",
    "min_delay_ms": 1000,
    "jitter": "full",
    "retry_on_http_status": [
      429,
      500,
      502,
      503
    ]
  },
  "rate_limit_headers": {
    "requests_limit": "x-ratelimit-limit-requests",
    "requests_remaining": "x-ratelimit-remaining-requests",
    "tokens_limit": "x-ratelimit-limit-tokens",
    "tokens_remaining": "x-ratelimit-remaining-tokens"
  },
  "parameter_mappings": {
    "model": "model",
    "messages": "messages",
    "temperature": "temperature",
    "max_tokens": "max_tokens",
    "top_p": "top_p",
    "frequency_penalty": "frequency_penalty",
    "presence_penalty": "presence_penalty",
    "stop": "stop",
    "stream": "stream"
  },
  "notes": [
    "Anyscale provides Ray-based model serving infrastructure",
    "OpenAI-compatible API with multiple model options",
    "Supports various LLMs including Llama, Mistral, and others",
    "Enterprise-grade model serving platform"
  ]
}