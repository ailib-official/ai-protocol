{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ailib-official/ai-protocol/main/schemas/v2/provider-identity.json",
  "title": "AI Protocol Provider Identity Map (PT-ARCH-005)",
  "description": "Normative canonical id + alias map for cross-tree provider identity (Audit F5 / PT-ARCH-005). Source of truth for authors: v2/provider-identity.fixture.json. Published for package consumers as dist/provider-identity.json (see dist/index.json identity). Runtimes that only consume schemas/dist MUST still resolve provider.aliases and this map.",
  "type": "object",
  "required": ["canonical_id", "aliases", "trees"],
  "additionalProperties": false,
  "properties": {
    "canonical_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]{1,63}$"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-_]{1,63}$"
      },
      "uniqueItems": true
    },
    "trees": {
      "type": "object",
      "required": ["v1", "v2", "v2-alpha"],
      "additionalProperties": false,
      "properties": {
        "v1": { "$ref": "#/$defs/treeEntry" },
        "v2": { "$ref": "#/$defs/treeEntry" },
        "v2-alpha": { "$ref": "#/$defs/treeEntry" }
      }
    },
    "runtime_lookup": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "treeEntry": {
      "type": "object",
      "required": ["primary_id", "file"],
      "additionalProperties": false,
      "properties": {
        "primary_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-_]{1,63}$"
        },
        "file": { "type": "string", "minLength": 1 },
        "aliases_on_manifest": {
          "type": "array",
          "items": { "type": "string" }
        },
        "graduation_target": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
