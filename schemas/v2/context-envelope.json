{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ailib-official/ai-protocol/main/schemas/v2/context-envelope.json",
  "title": "Context Envelope / MessageChunk (Experimental)",
  "description": "PT-ARCH-003 / Audit F3. Protocol catch-up for layered context assembly already implemented in ai-lib-rust (MessageChunk / ContextLayer). Status: Experimental. Aligns with ADR-2026-07 layers 0–5. HardBudget: System+Active must fit or assembly fails.",
  "type": "object",
  "required": ["schema_version", "status", "chunks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0-experimental"
    },
    "status": {
      "type": "string",
      "enum": ["experimental"]
    },
    "strategy": {
      "type": "string",
      "enum": ["chat", "code-fix"],
      "default": "chat",
      "description": "AssembleStrategy: chat | code-fix"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "reserve_output_tokens": { "type": "integer", "minimum": 0 },
        "min_tail_messages": { "type": "integer", "minimum": 0 }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/message_chunk" }
    }
  },
  "$defs": {
    "context_layer": {
      "type": "string",
      "enum": [
        "system",
        "active",
        "relevant",
        "summary",
        "background",
        "archive"
      ],
      "description": "Layer 0–5; system+active are critical (HardBudget)"
    },
    "message_role": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"]
    },
    "message_chunk": {
      "type": "object",
      "required": ["layer", "chunk_id", "role", "content"],
      "additionalProperties": false,
      "properties": {
        "layer": { "$ref": "#/$defs/context_layer" },
        "chunk_id": { "type": "string", "minLength": 1 },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Ordering key; higher = newer for background thinning"
        },
        "is_summary": { "type": "boolean", "default": false },
        "role": { "$ref": "#/$defs/message_role" },
        "content": { "type": "string" },
        "tool_call_id": {
          "type": "string",
          "description": "Required when role=tool for OpenAI-style wire"
        }
      }
    }
  }
}
