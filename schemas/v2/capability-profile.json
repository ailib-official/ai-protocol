{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hiddenpath/ai-protocol/main/schemas/v2/capability-profile.json",
  "title": "AI-Protocol Capability Profile (Experimental IOS Phase)",
  "description": "Optional I/O/S capability profile for design-stage governance. This phase intentionally limits scope to Inputs/Outcomes/Systems to avoid one-step full I/O/P/S/C rollout. Metadata-only and MUST NOT imply runtime behavioral changes by itself.",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["inputs"] },
    { "required": ["outcomes"] },
    { "required": ["systems"] }
  ],
  "properties": {
    "phase": {
      "type": "string",
      "enum": ["ios_v1"],
      "default": "ios_v1",
      "description": "Staged rollout marker. ios_v1 enables Inputs/Outcomes/Systems only."
    },
    "inputs": {
      "type": "object",
      "description": "Input constraints and limits (I)",
      "additionalProperties": false,
      "properties": {
        "modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["text", "image", "audio", "video", "tool_result", "other"]
          },
          "uniqueItems": true
        },
        "max_references": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_payload_mb": {
          "type": "number",
          "minimum": 0,
          "maximum": 2048
        }
      }
    },
    "outcomes": {
      "type": "object",
      "description": "Semantic output declaration (O)",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text_completion",
              "structured_json",
              "image_generation",
              "video_generation",
              "reasoning_trace",
              "tool_call_sequence",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "quality_tier": {
          "type": "string",
          "enum": ["best_effort", "standard", "high"]
        }
      }
    },
    "systems": {
      "type": "object",
      "description": "External system dependencies (S)",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["mcp", "search", "filesystem", "browser", "gis", "other"]
          },
          "uniqueItems": true
        }
      }
    },
    "future_reserved": {
      "type": "array",
      "description": "Reserved names for future staged expansion.",
      "items": {
        "type": "string",
        "enum": ["process", "contract"]
      },
      "default": ["process", "contract"],
      "uniqueItems": true
    }
  }
}
