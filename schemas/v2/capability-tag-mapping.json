{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ailib-official/ai-protocol/main/schemas/v2/capability-tag-mapping.json",
  "title": "ProviderCapability ↔ CapabilityTag mapping (Experimental)",
  "description": "PT-ARCH-002 / Audit F2. Bridges wire ProviderCapability names (schemas/v2/capabilities.json) and route CapabilityTag vocabulary. Status: Experimental — not a stable consume surface until GOV-006 review promotes it. Route Tag source of truth remains capability-mapping.md until this schema is versioned stable.",
  "type": "object",
  "required": ["schema_version", "status", "mappings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0-experimental"
    },
    "status": {
      "type": "string",
      "enum": ["experimental"],
      "description": "Must remain experimental until Protocol Proposal promotion"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping_entry" }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "provider_capability": {
      "type": "string",
      "description": "Wire / feature capability (ProviderCapability)",
      "enum": [
        "text",
        "streaming",
        "vision",
        "audio",
        "video",
        "tools",
        "parallel_tools",
        "agentic",
        "reasoning",
        "embeddings",
        "structured_output",
        "batch",
        "image_generation",
        "computer_use",
        "mcp_client",
        "mcp_server",
        "stt",
        "tts",
        "rerank"
      ]
    },
    "capability_tag": {
      "type": "string",
      "description": "Route / intent CapabilityTag (plans capability-mapping.md v0.1.x)",
      "enum": [
        "high-reasoning",
        "coding",
        "speed",
        "document_understanding",
        "tool_calling",
        "long_context"
      ]
    },
    "mapping_entry": {
      "type": "object",
      "required": ["capability_tag", "relation"],
      "additionalProperties": false,
      "properties": {
        "capability_tag": { "$ref": "#/$defs/capability_tag" },
        "relation": {
          "type": "string",
          "enum": ["requires_any", "requires_all", "prefers", "unrelated_wire"],
          "description": "How Tag relates to wire ProviderCapability set"
        },
        "provider_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/provider_capability" },
          "uniqueItems": true,
          "description": "Wire capabilities involved; empty only when relation=unrelated_wire"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
